#!/bin/bash
# Boot script of the monitoring host (Amazon Linux 2023).
# Installs Docker + Compose and a small wrapper, monitoring-sync, that every 5 minutes downloads the
# real sync script from S3 (Terraform/monitoring/bin/monitoring-sync.sh) and runs it.
# Everything that changes lives in S3, so this boot script (and the instance) rarely has to change.
set -euo pipefail

dnf install -y docker jq
systemctl enable --now docker

# Docker Compose v2 plugin (not packaged for AL2023)
install -d /usr/local/lib/docker/cli-plugins
curl -fsSL -o /usr/local/lib/docker/cli-plugins/docker-compose \
  https://github.com/docker/compose/releases/download/v2.29.7/docker-compose-linux-x86_64
chmod 755 /usr/local/lib/docker/cli-plugins/docker-compose

install -d /etc/monitoring
cat > /etc/monitoring/env <<'EOV'
BUCKET=${bucket}
CLUSTER=${cluster_name}
REGION=${aws_region}
SLACK_SECRET=${slack_secret_name}
EOV

cat > /usr/local/bin/monitoring-sync <<'EOS'
#!/bin/bash
set -euo pipefail
set -a; . /etc/monitoring/env; set +a
aws s3 cp "s3://$BUCKET/bin/monitoring-sync.sh" /usr/local/lib/monitoring-sync.sh \
  --only-show-errors --region "$REGION"
exec /bin/bash /usr/local/lib/monitoring-sync.sh
EOS
chmod 755 /usr/local/bin/monitoring-sync

cat > /etc/systemd/system/monitoring-sync.service <<'EOU'
[Unit]
Description=Sync monitoring config from S3 and refresh credentials
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/monitoring-sync
EOU

cat > /etc/systemd/system/monitoring-sync.timer <<'EOU'
[Unit]
Description=Run monitoring-sync every 5 minutes

[Timer]
OnBootSec=30s
OnUnitActiveSec=5min

[Install]
WantedBy=timers.target
EOU

systemctl daemon-reload
systemctl enable --now monitoring-sync.timer
systemctl start --no-block monitoring-sync.service
