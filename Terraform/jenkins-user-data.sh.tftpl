#!/bin/bash
set -euo pipefail

# Create Jenkins bootstrap configuration
install -d -m 755 /etc/jenkins

cat > /etc/jenkins/bootstrap.env <<'EOF'
JENKINS_ADMIN_USER=admin
JENKINS_ADMIN_SECRET_ID=infinity-weather/jenkins-admin-password
EOF

chown root:root /etc/jenkins/bootstrap.env
chmod 600 /etc/jenkins/bootstrap.env


# Wait for the persistent Jenkins EBS volume
# Wait for the persistent Jenkins EBS volume
VOLUME_ID="${jenkins_volume_id}"
VOLUME_ID_NODASH="${jenkins_volume_id_nodash}"

DEVICE=""

for i in $(seq 1 60); do
  for candidate in \
    "/dev/disk/by-id/nvme-Amazon_Elastic_Block_Store_$VOLUME_ID" \
    "/dev/disk/by-id/nvme-Amazon_Elastic_Block_Store_$VOLUME_ID_NODASH"; do

    if [ -b "$candidate" ]; then
      DEVICE="$candidate"
      break 2
    fi
  done

  sleep 10
done

if [ -z "$DEVICE" ]; then
  echo "ERROR: Jenkins EBS volume $VOLUME_ID was not attached"
  exit 1
fi

echo "Jenkins EBS found: $DEVICE"

# Verify that the persistent EBS has an ext4 filesystem
FS_TYPE=$(blkid -s TYPE -o value "$DEVICE" || true)

if [ "$FS_TYPE" != "ext4" ]; then
  echo "ERROR: Jenkins EBS must contain an ext4 filesystem."
  echo "Detected filesystem: $${FS_TYPE:-none}"
  exit 1
fi

# Mount persistent Jenkins EBS
mkdir -p /mnt/jenkins-data
mount "$DEVICE" /mnt/jenkins-data

# Initialize a new volume with Jenkins files from Golden AMI
if [ ! -f /mnt/jenkins-data/.jenkins-volume-initialized ]; then
  if [ -n "$(ls -A /mnt/jenkins-data | grep -v '^lost+found$')" ]; then
    echo "ERROR: EBS contains existing data. Refusing initialization."
    exit 1
  fi

  cp -a /var/lib/jenkins/. /mnt/jenkins-data/

  # Set ownership only during initial volume preparation
  chown -R jenkins:jenkins /mnt/jenkins-data
  touch /mnt/jenkins-data/.jenkins-volume-initialized
fi

# Mount EBS as Jenkins Home
umount /mnt/jenkins-data
mount "$DEVICE" /var/lib/jenkins

# Persist the EBS mount across reboots
UUID=$(blkid -s UUID -o value "$DEVICE")

if [ -z "$UUID" ]; then
  echo "ERROR: Could not determine EBS filesystem UUID"
  exit 1
fi

# nofail: a missing volume must not drop the instance into emergency mode (SSM would be unreachable)
echo "UUID=$UUID /var/lib/jenkins ext4 defaults,nofail 0 2" >> /etc/fstab

# Jenkins must not start without its persistent EBS
mkdir -p /etc/systemd/system/jenkins.service.d

cat > /etc/systemd/system/jenkins.service.d/ebs.conf <<'EOF'
[Unit]
RequiresMountsFor=/var/lib/jenkins
EOF

# Keep retrying instead of giving up after 5 fast failures: on a fresh build the instance can
# start before its IAM policy is attached, and the admin-password script then gets AccessDenied.
cat > /etc/systemd/system/jenkins.service.d/restart.conf <<'EOF'
[Unit]
StartLimitIntervalSec=0

[Service]
Restart=on-failure
RestartSec=15s
EOF

# Kubeconfig for the Kubernetes plugin.
# The EKS endpoint and CA change every time the cluster is recreated, so instead of storing them
# in the Jenkins cloud settings, the kubeconfig is generated at boot. It authenticates with the
# instance role (aws eks get-token); the EKS access entry for this role allows pods in namespace
# "jenkins". In Jenkins, the Kubernetes cloud keeps "Kubernetes URL" and "Credentials" EMPTY,
# so the plugin auto-configures from ~/.kube/config.
cat > /usr/local/bin/jenkins-kubeconfig <<'EOS'
#!/bin/bash
set -uo pipefail
CLUSTER="${eks_cluster_name}"
REGION="${aws_region}"
KCFG=/var/lib/jenkins/.kube/config

# On a fresh build EKS becomes ACTIVE ~10 minutes after this instance; wait up to 30 minutes
for i in $(seq 1 90); do
  STATUS=$(aws eks describe-cluster --name "$CLUSTER" --region "$REGION" \
             --query cluster.status --output text 2>/dev/null || true)
  [ "$STATUS" = "ACTIVE" ] && break
  sleep 20
done

if [ "$STATUS" != "ACTIVE" ]; then
  echo "jenkins-kubeconfig: cluster $CLUSTER is not ACTIVE, kubeconfig not updated" >&2
  exit 0
fi

install -d -o jenkins -g jenkins -m 700 /var/lib/jenkins/.kube
aws eks update-kubeconfig --name "$CLUSTER" --region "$REGION" --kubeconfig "$KCFG"
chown jenkins:jenkins "$KCFG"
chmod 600 "$KCFG"
EOS
chmod 755 /usr/local/bin/jenkins-kubeconfig

cat > /etc/systemd/system/jenkins-kubeconfig.service <<'EOF'
[Unit]
Description=Generate kubeconfig for the Jenkins Kubernetes plugin
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/var/lib/jenkins

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=40min
ExecStart=/usr/local/bin/jenkins-kubeconfig

[Install]
WantedBy=multi-user.target
EOF

cat > /etc/systemd/system/jenkins.service.d/kubeconfig.conf <<'EOF'
[Unit]
Wants=jenkins-kubeconfig.service
After=jenkins-kubeconfig.service
EOF

# Start Jenkins after bootstrap configuration is ready.
# --no-block: do not hold cloud-init while jenkins-kubeconfig waits for the cluster.
systemctl daemon-reload
systemctl enable jenkins-kubeconfig.service jenkins
systemctl start --no-block jenkins
