variable "aws_region" {
  description = "AWS region"
  type        = string
  default     = "eu-north-1"
}

variable "project_name" {
  description = "Project name, used as a prefix for resource names"
  type        = string
  default     = "infinity-weather"
}

variable "vpc_cidr" {
  description = "CIDR block for the VPC"
  type        = string
  default     = "10.0.0.0/16"
}

variable "domain_name" {
  description = "Existing public Route 53 domain"
  type        = string
}

variable "admin_cidrs" {
  description = "Public CIDRs allowed to reach GitLab, Jenkins, Argo CD, Git over SSH and the EKS API"
  type        = list(string)

  validation {
    condition     = length(var.admin_cidrs) > 0 && alltrue([for c in var.admin_cidrs : can(cidrhost(c, 0))])
    error_message = "admin_cidrs must contain at least one valid CIDR, for example 203.0.113.10/32."
  }
}

# Persistent data volumes, created outside Terraform so they survive `terraform destroy`
variable "gitlab_ebs_volume_id" {
  description = "Persistent EBS volume with GitLab data (zone a)"
  type        = string
}

variable "jenkins_ebs_volume_id" {
  description = "Persistent EBS volume with Jenkins data (zone b)"
  type        = string
  default     = "vol-0b409a613ee21b6e0"
}

# GitOps / Argo CD
variable "gitlab_group" {
  description = "GitLab group (namespace) that holds the weather-gitops project"
  type        = string
  default     = "hdo5"
}

variable "gitops_repo_url" {
  description = "Override for the GitOps repository URL; empty = ssh://git@gitlab.internal.<domain>:2222/<group>/weather-gitops.git"
  type        = string
  default     = ""
}

variable "argocd_app_name" {
  description = "Name of the Argo CD Application for the weather app"
  type        = string
  default     = "weather"
}

variable "gitlab_ssh_known_hosts" {
  description = "known_hosts line(s) for [gitlab.internal.<domain>]:2222 (ssh-keyscan -p 2222 ...). Empty = Argo CD skips host key checking"
  type        = string
  default     = ""
}

variable "argocd_admin_password_bcrypt" {
  description = "Bcrypt hash of the Argo CD admin password (argocd account bcrypt --password ...). null = generated by Terraform, see output argocd_admin_password"
  type        = string
  default     = null
  sensitive   = true
}

variable "argocd_readonly_users" {
  description = "Read-only Argo CD local users: name => bcrypt hash of the password"
  type        = map(string)
  default     = {}
  sensitive   = true
}
