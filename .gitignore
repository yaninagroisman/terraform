tmp/
temp/
.cache/
*.bak
*.tmp
# Backup files
*.bkp
.$*
.tar.gz

# Terraform output
plan.txt
terraform-state-backup.json

# Accidental files in Terraform directory
/Terraform/Accept:
/Terraform/GET
/Terraform/ec2 describe-security-groups \
